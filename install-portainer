#!/bin/sh

set -e

# dependencies
./install-docker

echo "ALPINEBOX: Installing Hostbox (Portainer core stack)"

if [ ! -e /root/portainer-templates ]; then
    git clone https://github.com/psy0rz/portainer-templates.git /root/portainer-templates
fi

cd /root/portainer-templates/core
if ! [ -e .env ]; then
    cp .env-example .env
fi

echo
echo "ALPINEBOX: Hostbox downloaded to /root/portainer-templates"
echo
echo "ALPINEBOX: To finish the setup:"
echo "ALPINEBOX:   1. Go to /root/portainer-templates/core/"
echo "ALPINEBOX:   2. Edit the .env file. Set DOMAIN and the Let's Encrypt or ZeroSSL settings."
echo "ALPINEBOX:   3. Run ./setup.sh and type the admin password."
echo "ALPINEBOX:   4. Log in at https://<DOMAIN>/server-manager/ as admin."
