#!/bin/sh

# Snapshot, upgrade and quick-reboot system. Rollback on failure.

set -e



ZFS_AUTOBACKUP=/root/.local/bin/zfs-autobackup

# Same pipx copy as install-zfs-autobackup. Also repairs it when a Python upgrade broke its venv.
ensure_zfs_autobackup() {
    if ! $ZFS_AUTOBACKUP --version >/dev/null 2>&1; then
        apk add pipx
        pipx install --force zfs-autobackup
    fi
}

zfs_snapshot() {
    ensure_zfs_autobackup
    zfs set autobackup:system_upgrade=true rpool/ROOT
    $ZFS_AUTOBACKUP system_upgrade --keep-source=3,1d3d
}

# Rebuild the venv against the (possibly new) Python, and get the latest zfs-autobackup.
# Keeps the daily backup job working after an Alpine release upgrade.
reinstall_zfs_autobackup() {
    pipx reinstall zfs-autobackup || echo "ALPINEBOX: WARNING: pipx reinstall of zfs-autobackup failed"
}

zfs_rollback_system() {
    #rpool
    LATEST=`zfs list -H -t snapshot -o name -S creation rpool/ROOT |head -n1` || true
    if [ "$LATEST" ]; then
        echo "ALPINEBOX: Rolling back to $LATEST"
        zfs rollback $LATEST || true
    fi
}


apk update 

#are there updates?
if apk list -u | grep . >/dev/null; then

    zfs_snapshot

    # try it:
    if apk upgrade -a; then
        # ok, quick reboot
        reinstall_zfs_autobackup
        echo "ALPINEBOX: Upgrade OK, rebooting."
        /root/alpinebox/quick-reboot
    else
        echo "ALPINEBOX: Upgrade FAILED!"
        zfs_rollback_system
        /root/alpinebox/quick-reboot force
    fi
else
    echo "ALPINEBOX: No updates"
fi

